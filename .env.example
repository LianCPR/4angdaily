# Copy to .env.local for local dev, or set these as real environment variables
# in your host (e.g. Vercel Project Settings -> Environment Variables).

# Admin login for /admin. Change these before deploying.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=@Ether280611

# Long random string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ffe87b87429795e2ed6b6029d32ec19a98ef7323a987585449cdc454c8e8bfe1

# Public site URL, used for canonical/Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Turso / libSQL) ---
# Leave both unset for local dev -> falls back to a local SQLite file at
# data/journal.db, zero setup required.
# For any serverless host (Vercel, etc.) where local disk doesn't persist,
# create a free database at https://turso.tech and set both:
TURSO_DATABASE_URL=libsql://4angdaily-naomi.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=eyJhbGciOiJFZERTQSIsInR5cCI6IkpXVCJ9.eyJhIjoicnciLCJpYXQiOjE3ODkzODY3NzUsImlkIjoiMDFhMDlmYzEtMzEwMS03YjgyLWJkZWMtY2ZmNGQzY2NiZmNkIiwia2lkIjoiUXJINENXZ2lNZGZiM0puemoyQ3J6b2ZxUEJQYmNlZGNCajdSdzRYaXNOdyIsInJpZCI6ImYzMDhkMTI5LTQxZmMtNGYzNy04NGVlLWFhYzI5YzdmN2Q5NiJ9.1BP0du5380xI8GO6gtmtERvHMv8zIJeTRFF9oDWwgGU-Yl7BlPrjVxMh0uCf-YijqseCjg1d6iDJ5kxH5UR6CQ

# --- Media storage (Vercel Blob) ---
# Leave unset for local dev -> uploads are written to public/uploads on disk.
# On Vercel: Project -> Storage -> Create Database -> Blob. Vercel injects
# this automatically once a Blob store is connected to the project; you
# generally don't need to set it by hand.
BLOB_READ_WRITE_TOKEN=
